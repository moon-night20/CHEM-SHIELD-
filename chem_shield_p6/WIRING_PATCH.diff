+function renderAutoResponse(status) {
+  const line = $('risk-alert-countdown');
+  if (!status || !status.enabled || status.state === 'IDLE') { line.hidden = true; return; }
+  line.hidden = false;
+  line.textContent = status.state === 'COUNTDOWN'
+    ? `Automatic stop in ${Math.ceil(status.seconds_remaining)} s unless you acknowledge or take control.`
+    : status.message;
+  if (status.state === 'COUNTDOWN' && status.incident_id && !$('risk-alert-dialog').open) {
+    alertIncidentId = status.incident_id;
+    $('risk-alert-title').textContent = 'CRITICAL RISK INCIDENT';
+    $('risk-alert-message').textContent = 'A critical incident was detected on the machine. Acknowledging records that you are handling it and cancels the automatic stop.';
+    $('risk-alert-dialog').showModal();
+  }
+}
