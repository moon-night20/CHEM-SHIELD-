+    def _auto_stop():
+        nonlocal paused
+        current = plc_call(read_state)
+        result = plc_call(lambda client: client.write_registers(0, [0, current["target_rpm"]], slave=1))
+        if result.isError():
+            raise RuntimeError(f"Simulator rejected the automatic stop: {result}")
+        plc_call(lambda client: client.write_register(6, 0, slave=1))
+        paused = False
+
+    def _auto_clear_overrides():
+        result = plc_call(lambda client: client.write_register(8, 0, slave=1))
